# PostgreSQL connection. Leave empty to use the embedded database (PGlite) in ./data,
# which is enough for local development.
DATABASE_URL=

# Public URL of the site. Required in production (the server refuses to start without it): used for
# form CSRF checks and absolute links in the API. Must be https except for localhost.
ORIGIN=http://localhost:3000

# First administrator, created on startup if no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@takumilabs.org
ADMIN_PASSWORD=

# Shared secret GitHub Actions uses to register launcher releases (POST /api/releases).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELEASE_API_TOKEN=

# Private instances ----------------------------------------------------------------------------
# Ed25519 key that signs instance manifests (base64 PKCS#8 DER). Required in production to publish.
# Generate once and keep it secret; the launcher embeds the matching public key, so changing it means
# rebuilding the launcher:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# Public key for the launcher build (TAKUMI_MANIFEST_PUBKEY): GET /api/launcher/manifest-key
MANIFEST_SIGNING_KEY=

# Where uploaded instance files are stored (content-addressed). Must be persistent and backed up.
STORAGE_DIR=./data/storage

# adapter-node rejects request bodies above this size (default 512K). Uploads of mods need more.
BODY_SIZE_LIMIT=600M
