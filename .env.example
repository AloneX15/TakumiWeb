# PostgreSQL connection. Leave empty to use the embedded database (PGlite) in ./data,
# which is enough for local development.
DATABASE_URL=

# Public URL of the site (required in production by adapter-node for form CSRF checks).
ORIGIN=http://localhost:3000

# First administrator, created on startup if no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@takumilabs.org
ADMIN_PASSWORD=

# Shared secret GitHub Actions uses to register launcher releases (POST /api/releases).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELEASE_API_TOKEN=
